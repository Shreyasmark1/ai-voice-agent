PORT=8765

NEXTJS_URL=http://localhost:3000

# OpenAI-compatible LLM provider (OpenRouter, OpenAI, or any compatible provider)
LLM_API_KEY=
LLM_API_ENDPOINT=https://openrouter.ai/api/v1
LLM_MODEL=poolside/laguna-xs-2.1:free

# optional if the LLM_API_ENDPOINT supports openai compatible tts and stt
SARVAM_API_KEY=

# TTS provider: sarvam or openai (openai for any open ai compatible provider)
TTS_PROVIDER=sarvam
TTS_MODEL=bulbul:v3

# Sarvam TTS quality knobs (bulbul:v3 / v3-beta). Larger buffer = smoother,
# more natural prosody at the cost of a bit more latency before first audio.
TTS_PACE=0.95
TTS_TEMPERATURE=0.4
TTS_MIN_BUFFER_SIZE=200
TTS_MAX_CHUNK_LENGTH=300

# STT provider: sarvam or openai (openai for any open ai compatible provider)
STT_PROVIDER=sarvam
STT_MODEL=openai/whisper-large-v3